<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>File Occupied Release</Product>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets/FileOccupiedRelease.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/FileOccupiedRelease.ico" LogicalName="FileOccupiedRelease.AppIcon" />
  </ItemGroup>
</Project>
